---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
---

<DefaultFooter />
  <footer class="docs-footer">
    <div class="docs-footer-grid">
      <div class="docs-footer-intro">
        <p class="footer-headline">A faster download.<br />One terminal away.</p>
        <a class="docs-footer-cta" href="/#downloads">Get Surge</a>
      </div>
      <div class="docs-footer-links">
        <span class="docs-footer-label">Navigation</span>
        <a href="/#features">Features</a>
        <a href="/#benchmarks">Benchmarks</a>
        <a href="/#downloads">Downloads</a>
        <a href="/#extension">Extension</a>
        <a href="/docs/">Docs</a>
      </div>
      <div class="docs-footer-links">
        <span class="docs-footer-label">Connect</span>
        <a href="https://github.com/surgedm/surge"
          target="_blank" rel="noopener">GitHub</a>
        <a href="https://x.com/SurgeDownloader"
          target="_blank" rel="noopener">X</a>
        <a
          href="https://github.com/surgedm/surge/discussions" target="_blank" rel="noopener">Discussions</a>
        <a
          href="https://www.buymeacoffee.com/surge.downloader" target="_blank" rel="noopener">Support us</a>
      </div>
    </div>
    <div class="docs-footer-wordmark" aria-hidden="true">Surge<span>.</span></div>
    <div
      class="docs-footer-meta">
      <p>© Surge contributors</p>
      <div class="docs-footer-legal">
        <a href="https://github.com/surgedm/surge/blob/main/LICENSE"
          target="_blank" rel="noopener">MIT License</a>
        <a href="https://github.com/surgedm/surge/blob/main/CONTRIBUTING.md"
          target="_blank" rel="noopener">Contributing</a>
        <a href="/privacy.html">Privacy</a>
      </div>
    </div>
  </footer>
