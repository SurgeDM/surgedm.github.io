---
import "../styles/site-footer.css";
---
<footer class="site-footer">
    <div class="site-footer-inner">
      <div class="site-footer-grid">
        <div class="site-footer-intro">
          <p class="footer-headline">A faster download.<br />One terminal away.</p>
          <a class="site-footer-cta" href="/#downloads">Get Surge</a>
        </div>
        <div class="site-footer-links">
          <span class="site-footer-label">Navigation</span>
          <a href="/">Home</a>
          <a href="/#features">Features</a>
          <a href="/#benchmarks">Benchmarks</a>
          <a href="/#downloads">Downloads</a>
          <a href="/#extension">Extension</a>
          <a href="/docs/">Docs</a>
        </div>
        <div class="site-footer-links">
          <span class="site-footer-label">Connect</span>
          <a href="https://github.com/surgedm/surge"
            target="_blank" rel="noopener">GitHub</a>
          <a href="https://x.com/SurgeDownloader"
            target="_blank" rel="noopener">X</a>
          <a
            href="https://github.com/surgedm/surge/discussions" target="_blank" rel="noopener">Discussions</a>
          <a
            href="/#support">Support us</a>
        </div>
      </div>
      <div class="site-footer-wordmark" aria-hidden="true">Surge<span>.</span></div>
      <div class="site-footer-meta">
        <p>© Surge contributors</p>
        <div class="site-footer-legal">
          <a href="https://github.com/surgedm/surge/blob/main/LICENSE"
            target="_blank" rel="noopener">MIT License</a>
          <a href="https://github.com/surgedm/surge/blob/main/CONTRIBUTING.md"
            target="_blank" rel="noopener">Contributing</a>
          <a href="/privacy/">Privacy</a>
        </div>
      </div>
    </div>
</footer>
