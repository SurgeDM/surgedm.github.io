---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---
<MarketingLayout title="Page not found | Surge" description="The Surge page you requested couldn't be found.">
  <div class="utility-page space-y-6">
    <p class="font-mono text-primary">404</p>
    <h1 class="text-4xl md:text-5xl font-black text-white tracking-tighter">Page not found</h1>
    <p class="text-on-surface-variant">Find Surge downloads on the homepage or browse the documentation.</p>
    <div class="flex flex-wrap items-center gap-5">
      <a class="utility-action rounded-lg bg-primary px-5 py-3 font-bold text-on-primary" href="/">Back to homepage</a>
      <a href="/docs/">Browse the docs</a>
    </div>
  </div>
</MarketingLayout>
